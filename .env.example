# Copy to .env (in the project root or server/) and fill in. Never commit real values.

# AES-256 key for citizen profiles: base64 of 32 random bytes.
# Generate: python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
FACTVERIFY_ENCRYPTION_KEY=

# Optional: require this token in the X-API-Token header for all /api calls (enter it in the dashboard header).
FACTVERIFY_API_TOKEN=

# ---------- AI team: which model does which job ----------
# Comma-separated = order of preference: the first one with a key is used. Empty = role off.
AI_RESEARCH=gemini
AI_TRANSLATION=sarvam,gemini,groq
AI_SPEECH=sarvam,groq,elevenlabs,whisper,gemini
AI_VOICE=sarvam,elevenlabs
AI_OCR=ocrspace,tesseract
AI_IMAGE_AI=localdetector,sightengine
AI_VISION=openai,gemini
AI_REVIEW=mistral,cohere,ollama,groq,claude,openai

# ---------- API keys (each member uses their own; never commit this file) ----------

# 1. Google Gemini - live web research with sources        https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-4-argon
GEMINI_FALLBACK_MODELS=gemini-3.8-flash,gemini-2.5-pro
GEMINI_FAST_MODEL=gemini-3.8-flash

# 2. Sarvam AI - Indian-language translation, speech-to-text, text-to-speech   https://dashboard.sarvam.ai
SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v3
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=shubh

# 3. ElevenLabs - natural multilingual voice + speech-to-text   https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
ELEVENLABS_STT_MODEL=scribe_v2

# 4. Groq - very fast Whisper speech-to-text                https://console.groq.com/keys
GROQ_API_KEY=
GROQ_STT_MODEL=whisper-large-v3

# 5a. Local AI-image detector - FREE, runs on your laptop, NO account or key
#     Setup: pip install transformers torch   (the ~350 MB model downloads automatically on first start)
LOCAL_AI_IMAGE_MODEL=Organika/sdxl-detector
LOCAL_AI_IMAGE_DISABLED=false

# 5b. Sightengine (optional backup) - AI-generated image / deepfake detection   https://sightengine.com
SIGHTENGINE_API_USER=
SIGHTENGINE_API_SECRET=
SIGHTENGINE_MODELS=genai

# 6. OCR.space - text in images incl. Hindi, Tamil, Telugu, Kannada   https://ocr.space/ocrapi
OCR_SPACE_API_KEY=

# 7. OpenAI - image understanding (vision), backup reviewer  https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# ---------- Second opinion (free options; the first one set up is used) ----------

# 9. Mistral AI - free Experiment plan, no credit card (phone verification)   https://console.mistral.ai/api-keys
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

# 10. Cohere - free trial key, no credit card               https://dashboard.cohere.com/api-keys
COHERE_API_KEY=
COHERE_MODEL=command-a-03-2025

# 11. Ollama - runs on your own laptop: free, offline, NO account or key needed
#     Install https://ollama.com/download , then run once:  ollama pull qwen3:8b
#     (smaller laptops: OLLAMA_MODEL=qwen3:4b)
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b

# 8. Anthropic Claude (paid, optional) - second opinion     https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Address the browser agent uses to reach the bundled sandbox portal (match your uvicorn host/port).
FACTVERIFY_PUBLIC_BASE_URL=http://127.0.0.1:8000

# Set to false to watch the agent drive a visible Chrome window (great for live demos).
AGENT_HEADLESS=true

AUTHENTICITY_THRESHOLD=0.75
AGENT_STEP_TIMEOUT_MS=15000
AGENT_HUMAN_WAIT_SECONDS=900
PROFILE_RETENTION_HOURS=24
MAX_UPLOAD_MB=50
ALLOW_URL_FETCH=true
